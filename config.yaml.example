# 一些全局字段
globals:
  # 并发
  concurrency: 16
  # 模型调用限制次数
  recursion_limit: 3
  # generate结果保存路径
  output_dir: "./generated"

# 定义任务中需要用到的模型
models:
  4o_teacher:
    type: openai
    api_key: <YOUR_API_KEY>
    base_url: <YOUR_BASE_URL>
    # model: gpt-4o
    model: gemini-3.1-pro-preview
    # 如果需要指定特殊参数
    # kargs字段中的参数会在调用模型时传入，具体参数取决于你使用的模型和底层实现，常见的参数有temperature、max_tokens等
    kargs:
      temperature: 0.7
  gemini_stu:
    type: openai
    api_key: <YOUR_API_KEY>
    base_url: <YOUR_BASE_URL>
    # model: gemini-2.5-pro-exp-03-25
    model: gpt-4o

# 定义任务中需要使用的agent
agents:
  # agent名，字段可自定义，在本例中为teacher
  teacher:
    # 该agent用到的模型
    model: 4o_teacher
    # 提示词，其中可使用task.content中的字段
    # system_prompt 可以是 str 也可以是 list[str]
    system_prompt: ｜
      你是一位富有耐心和爱心的数学老师，今天你的任务是为这位学生提供一对一的引导式教学。以下是学生的画像信息：{image}。请根据该学生的特点，个性化地引导讲解数学题，在教学过程中自然融入个性化支持、价值观引导以及创造力激发。

      ---

      \#\#\# 教学要求

      请采用**引导式教学法**帮助学生解决数学问题，具体要求如下：

      * 以**一问一答**的方式进行教学，每次仅提出**一个引导性问题**，等待学生回答后再继续；
      * 不要直接给出答案，而应通过启发式提问引导学生自主思考；
      * 根据学生的学习特点，保持耐心，使用**简单清晰的语言**进行表达；
      * 在讲解过程中加入**积极的鼓励**与**情感支持**，增强学生的自信心；
      * 在适当场合融入**中国传统价值观**，如坚持、尊师重道、勤奋等；
      * 将复杂问题拆解为学生能理解的**小步骤**；
      * 尽量联系**生活实际场景**，使数学概念具体、生动。

      ---

      \#\#\# 创造力培养

      * 鼓励学生**从多个角度思考问题**，不拘泥于标准解法；
      * 引导其发现数学问题的多种可能解决方案；
      * 当学生尝试自主解题时，给予积极反馈和必要指导；
      * 善于将数学概念与学生兴趣（如**足球等体育活动**）相结合，激发创造性思维；
      * 设计**开放性问题**，培养学生的发散性思维；
      * 鼓励学生用自己的语言表达对数学概念的理解；
      * 对学生的创新思路和尝试表示赞赏，即使答案并不完全正确。

      ---

      请开始你的教学引导。请记住：

      * 一次只提一个问题；
      * 保持语言简洁、态度耐心、语气鼓励；
      * 不要提示过多，也**不要直接给出答案**；
      * 绝对不要替学生回答问题**，你的职责是当一名好老师；
      * 你每次只输出老师要说的内容，**不要同时扮演老师和学生
      * 教学结束时，请明确表示“下课”，可以使用 `<end>` 作为结束标志。
    # 以下memory配置为默认配置
    memory:
      enable: true # 是否启用记忆
      id: null # 记忆的id号，建议不填或留空，除非需要多次运行时保留记忆
      # 调用时携带多少轮上下文对话，一个user一个assistant记作一轮
      keep_turns: 3 # 默认3轮，即上方配置的prompt-[user-assistant-user-assistant-user-assistant]-user
  student:
    model: gemini_stu
    system_prompt: 你是一名{image}的学生,你的任务是学习掌握这节课老师所教的习题。
    # 该agent可以调用的工具列表，工具的具体配置在下方mcps字段中定义
    tools:
      - calculator # 该agent可以调用的工具列表，工具的具体配置在下方mcps字段中定义

# 信息传递方向
directions:
  # 从一个agent到另一个agent
  # START和END是两个特殊节点，也算作Agent
  # 箭头前后必须有空格，且箭头只能是->，不能是其他符号
  - START -> teacher # 程序开始后，首先激活teacher这个agent用于生成数据
  - teacher -> router:any_keyword_router(keywords=["<end>", "下课"], exists_to=END, else_to="student") # teacher agent生成结束后，经由keyword_route这个函数判断下一步导向哪里(END 还是 student)
  - student -> teacher # student agent生成结束后，直接激活teacher agent继续生成

tasks:
  # 由START进入第一个agent的prompt
  # start_prompt可选，如果未指定就只传agent中的prompt
  start_prompt: "这是本次一对一辅导所要讲的习题: {question}"
  # task模式， 可选union和iter
  # union指将content下所有字段各选一项排列组合，例如在本例中，就形成了len(image) * len(question)个task
  mode: union
  content:
    # content中的字段将被用于动态生成agents中的prompt，例如image将替换提示词中所有{image}
    image:
      - 认知能力强，逻辑思维突出，知识掌握全面且能灵活应用。性格开朗自信，班级小领袖，与师生关系融洽，对科学实验有浓厚兴趣。
      - 基础知识较扎实但应用能力需提升，在数学方面有一定困难。性格内向，在熟悉环境中友好交流，有少数亲密朋友，对绘画和手工制作感兴趣。
      # - 最基本的加减法都搞不清楚，认字量极少，上课完全听不懂。注意力无法集中，经常打断老师课堂，作业要么不交要么全错，在学校只对打闹感兴趣。
    question:
      # - 一个三位数，个位和百位数字交换后还是一个三位数，它与原三位数的差的个位数字是7，试求它们的差．
      - 师徒两人装配自行车，师傅每天装配32辆，徒弟每天比师傅少装配8辆．经过多少天师傅比徒弟多装配56辆？

  # iter代表遍历content中所有task，比较适合多个字段不能/不需要排列组合的情况
  # model: iter
  # content:
  #   - image: 西瓜
  #     question: 天为什么还不下雨
  #   - image: 渔夫
  #     question: 天为什么还不晴

# 设定用于评估的模型和提示词，以及输出的格式
evaluation:
  # 评估任务名称
  name: multiturn
  # 选择用于评估的模型
  judge_model: 4o_teacher
  # 被评估的对象名，随便写，用于可视化
  target: gpt-4o-mini
  # 要评估的字段
  fields:
    - name: accuracy # 评估维度名称
      rubric: 教师的教学内容是否正确无误，是否存在错误或误导性的地方。 # 评分细则，需要讲清楚是哪个agent的哪个方面的表现，以及评分时需要考虑的因素，越具体越好，示例的这种细则会导致评分容易走极端，建议细化。
      reason: true # 是否需要评分理由
    - name: guidance
      rubric: 教师的教学内容是否能够有效引导学生思考和理解，是否提供了清晰的解题思路和步骤。
      reason: true
    - name: pointing
      rubric: 教师的教学内容是否能够准确指向问题的关键点，是否能够帮助学生抓住问题的核心。
      reason: true
    - name: personalization
      rubric: 教师的教学内容是否能够根据学生的特点进行个性化的讲解，是否能够激发学生的兴趣和创造力。
      reason: true

mcps:
  # 在这里配置一些MCP Server，供Agent调用
  calculator:
    type: stdio # 支持stdio、http-with-sse、streamable-http三种类型
    command: "python"
    args: [".devs/calculator_mcp.py"]
    timeout: 30
    env:
      AUTH_TOKEN: "123456" # 如果MCP需要环境变量，可以在这里配置
  # 其他类型的MCP配置示例
  # calculator_http:
  #   type: http-with-sse
  #   url: "http://localhost:8000/calculate"
  #   timeout: 30
  #   headers:
  #     Authorization: "Bearer 123456" # 如果MCP需要认证，可以在这里配置请求头
  # calculator_stream:
  #   type: streamable-http
  #   url: "http://localhost:8000/stream-calculate"
  #   timeout: 30
  #   headers:
  #     Authorization: "Bearer 123456"
